@model ForgotPasswordForm
@{ViewData["Title"]="Forgot password";}
<div class="auth"><span class="eyebrow">ACCOUNT RECOVERY</span><h1>Reset password</h1><p>Enter the email address connected to your account.</p><form asp-action="ForgotPassword" method="post" class="panel stack"><div asp-validation-summary="All" class="error"></div><label>Email address<input asp-for="Email" type="email" autocomplete="email" autofocus/></label><button class="button">Send reset link</button></form><p><a asp-action="Login">Back to sign in</a></p></div>
