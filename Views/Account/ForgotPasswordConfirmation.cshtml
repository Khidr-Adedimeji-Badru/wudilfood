@{ViewData["Title"]="Check your email";var developmentLink=TempData["DevelopmentResetLink"] as string;}
<div class="auth"><span class="eyebrow">ACCOUNT RECOVERY</span><h1>Check your email</h1><div class="panel stack"><p>If an account matches that address, a password reset link has been sent.</p>@if(developmentLink!=null){<div class="status-banner"><strong>Development email preview</strong><p>SMTP is not configured. Use this local reset link:</p><a href="@developmentLink">Reset password</a></div>}</div><p><a asp-action="Login">Back to sign in</a></p></div>
