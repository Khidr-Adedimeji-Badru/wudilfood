@model RegisterForm
@{ViewData["Title"]="Create account";}
<div class="register-shell"><aside class="register-intro"><span class="eyebrow">JOIN WUDIL FOOD</span><h1>Your place in the food community.</h1><p id="role-summary">Save your details and keep all your orders together.</p><div class="role-benefits" id="role-benefits"><strong>With a customer account you can:</strong><span>View your complete order history</span><span>Save your delivery address</span><span>Receive in-app order updates</span></div><a class="guest-link" asp-controller="Marketplace" asp-action="Index">Prefer not to register? Order as a guest</a></aside><div class="register-form"><div class="register-heading"><h2>Create your account</h2><p>Already registered? <a asp-action="Login">Sign in</a></p></div><form asp-action="Register" method="post" class="panel stack"><div asp-validation-summary="All" class="error"></div><fieldset class="role-picker"><legend>Choose an account type</legend><label><input asp-for="Role" type="radio" value="@Roles.Customer"/><span><strong>Customer</strong><small>Order food</small></span></label><label><input asp-for="Role" type="radio" value="@Roles.Vendor"/><span><strong>Vendor</strong><small>Sell food</small></span></label></fieldset><div class="form-section"><h3>Your details</h3><div class="form-grid"><label>Full name<input asp-for="FullName" autocomplete="name"/></label><label>Phone number<input asp-for="Phone" autocomplete="tel"/></label><label class="wide">Email address<input asp-for="Email" type="email" autocomplete="email"/></label><label class="wide">Password<input asp-for="Password" type="password" autocomplete="new-password" placeholder="At least 10 characters"/></label></div></div><div class="form-section role-fields" data-role="Customer"><h3>Delivery details</h3><label>Default delivery address<input asp-for="Address" autocomplete="street-address" placeholder="Hostel, department, street or landmark"/></label></div><div class="form-section role-fields" data-role="Vendor"><h3>Business details</h3><p class="hint">An administrator will review your profile before your menu goes live.</p><div class="form-grid"><label>Business or kitchen name<input asp-for="BusinessName" data-role-required="true"/></label><label>Business location<input asp-for="Location" data-role-required="true"/></label></div></div><button class="button full" id="register-submit">Create customer account</button></form></div></div>
<script>(()=>{const radios=[...document.querySelectorAll('input[name="Role"]')],sections=[...document.querySelectorAll('.role-fields')],summary=document.getElementById('role-summary'),benefits=document.getElementById('role-benefits'),submit=document.getElementById('register-submit');const content={Customer:{summary:'Save your details and keep all your orders together.',title:'With a customer account you can:',items:['View your complete order history','Save your delivery address','Receive in-app order updates']},Vendor:{summary:'Publish your menu and manage every order in one place.',title:'With a vendor account you can:',items:['Manage menu, stock and schedules','Accept and prepare customer orders','Build trust with approved reviews']}};function update(){const role=radios.find(x=>x.checked)?.value||'Customer',copy=content[role];sections.forEach(s=>{const active=s.dataset.role===role;s.hidden=!active;s.querySelectorAll('[data-role-required]').forEach(i=>i.required=active)});summary.textContent=copy.summary;benefits.innerHTML='<strong>'+copy.title+'</strong>'+copy.items.map(x=>'<span>'+x+'</span>').join('');submit.textContent='Create '+role.toLowerCase()+' account'}radios.forEach(x=>x.addEventListener('change',update));update()})();</script>

