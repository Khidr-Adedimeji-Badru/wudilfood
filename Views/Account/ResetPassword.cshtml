@model ResetPasswordForm
@{ViewData["Title"]="Choose a new password";}
<div class="auth"><span class="eyebrow">ACCOUNT RECOVERY</span><h1>New password</h1><p>Choose a password with at least 10 characters.</p><form asp-action="ResetPassword" method="post" class="panel stack"><div asp-validation-summary="All" class="error"></div><input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/><label>New password<input asp-for="Password" type="password" autocomplete="new-password" autofocus/></label><label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password"/></label><button class="button">Update password</button></form></div>
