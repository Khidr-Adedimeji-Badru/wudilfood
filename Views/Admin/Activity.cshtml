@model List<AuditLog>
@{ViewData["Title"]="Audit activity";}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">AUDIT</span><h1>Administrative activity</h1><p>A chronological record of sensitive platform changes.</p></div><span class="queue-count">Latest @Model.Count</span></header><section class="admin-panel audit-timeline">@foreach(var audit in Model){<article><time>@audit.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</time><div><strong>@audit.Action</strong><p>@audit.EntityType @audit.EntityId · @audit.Details</p></div></article>}@if(!Model.Any()){<p class="admin-empty">No administrative actions recorded.</p>}</section></div></div>
