@model PlatformSetting
@{ViewData["Title"]="Platform settings";var categories=(List<Category>)ViewBag.Categories;}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">SETTINGS</span><h1>Platform configuration</h1><p>Manage fulfilment rules and marketplace categories.</p></div></header><div class="settings-grid"><form asp-action="Settings" method="post" class="admin-panel settings-form"><div class="panel-heading"><h2>Delivery</h2></div><label>Delivery fee (NGN)<input name="deliveryFee" type="number" value="@Model.DeliveryFee" min="0"/></label><label>Coverage description<textarea name="coverage" maxlength="500">@Model.Coverage</textarea></label><label class="check"><input type="checkbox" name="deliveryEnabled" value="true" checked="@Model.DeliveryEnabled"/> Enable platform delivery</label><button class="small-button">Save delivery settings</button></form><section class="admin-panel"><div class="panel-heading"><h2>Food categories</h2><span>@categories.Count</span></div><div class="category-list">@foreach(var category in categories){<span>@category.Name</span>}</div><form asp-action="Category" method="post" class="inline-create"><input name="name" required maxlength="80" placeholder="Category name"/><button class="small-button">Add</button></form></section></div></div></div>
