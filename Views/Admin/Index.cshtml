@{ViewData["Title"]="Admin overview";var orders=(List<FoodOrder>)ViewBag.RecentOrders;var vendors=(List<Vendor>)ViewBag.PendingList;var audits=(List<AuditLog>)ViewBag.RecentAudit;var popular=(List<WudilFood.Controllers.AdminProductStat>)ViewBag.Popular;}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">OVERVIEW</span><h1>Marketplace health</h1><p>Today’s operating picture across Wudil Food.</p></div><span class="live-indicator">Live overview</span></header>
@if((int)ViewBag.PendingVendors>0||(int)ViewBag.OpenComplaints>0){<div class="admin-alert"><div><strong>Items need attention</strong><span>@ViewBag.PendingVendors vendor applications · @ViewBag.OpenComplaints open cases</span></div><a asp-action="Moderation">Open queues</a></div>}
<div class="metric-grid"><article><span>Total orders</span><strong>@ViewBag.Orders</strong><a asp-action="Orders">View orders</a></article><article><span>Completed revenue</span><strong>NGN @(((decimal)ViewBag.Revenue).ToString("N0"))</strong><small>Recorded order value</small></article><article><span>Active vendors</span><strong>@ViewBag.Vendors</strong><a asp-action="Vendors">Manage vendors</a></article><article><span>Cancelled</span><strong>@ViewBag.Cancelled</strong><small>All-time orders</small></article></div>
<div class="admin-grid-main"><section class="admin-panel"><div class="panel-heading"><div><span class="eyebrow">RECENT</span><h2>Latest orders</h2></div><a asp-action="Orders">View all</a></div>@foreach(var order in orders){<a class="data-row" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><span><strong>@order.Reference</strong><small>@order.Customer.FullName · @order.Vendor.Name</small></span><span class="pill">@order.State</span><strong>NGN @order.Total.ToString("N0")</strong></a>}@if(!orders.Any()){<p class="admin-empty">No orders yet.</p>}</section>
<aside class="admin-side-stack"><section class="admin-panel"><div class="panel-heading"><h2>Vendor applications</h2><a asp-action="Vendors">Review</a></div>@foreach(var vendor in vendors){<div class="compact-row"><span><strong>@vendor.Name</strong><small>@vendor.Location</small></span><span class="pill">Pending</span></div>}@if(!vendors.Any()){<p class="admin-empty">Queue is clear.</p>}</section><section class="admin-panel"><div class="panel-heading"><h2>Top items</h2></div>@foreach(var item in popular){<div class="compact-row"><span>@item.Name</span><strong>@item.Quantity</strong></div>}@if(!popular.Any()){<p class="admin-empty">No sales data yet.</p>}</section></aside></div>
<section class="admin-panel"><div class="panel-heading"><h2>Recent admin activity</h2><a asp-action="Activity">Full audit log</a></div>@foreach(var audit in audits){<div class="activity-row"><span><strong>@audit.Action</strong><small>@audit.EntityType @audit.EntityId · @audit.Details</small></span><time>@audit.CreatedUtc.ToLocalTime().ToString("dd MMM, HH:mm")</time></div>}@if(!audits.Any()){<p class="admin-empty">No activity recorded.</p>}</section></div></div>
