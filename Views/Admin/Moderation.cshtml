@{ViewData["Title"]="Moderation";var reviews=(List<Review>)ViewBag.Reviews;var complaints=(List<Complaint>)ViewBag.Complaints;}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">MODERATION</span><h1>Reviews and cases</h1><p>Keep marketplace feedback useful and resolve customer issues.</p></div><span class="queue-count">@(reviews.Count+complaints.Count(x=>x.Resolution=="")) open</span></header><div class="moderation-grid"><section class="admin-panel"><div class="panel-heading"><h2>Pending reviews</h2><span>@reviews.Count</span></div>@foreach(var review in reviews){<article class="queue-item"><div><strong>@review.Rating/5 · @review.Order.Vendor.Name</strong><p>@review.Comment</p></div><form asp-action="Moderate" method="post"><input type="hidden" name="id" value="@review.Id"/><input name="reason" maxlength="300" placeholder="Moderation note"/><div class="actions"><button class="small-button" name="approved" value="true">Approve</button><button class="text-button danger-text" name="approved" value="false">Reject</button></div></form></article>}@if(!reviews.Any()){<p class="admin-empty">Review queue is clear.</p>}</section><section class="admin-panel"><div class="panel-heading"><h2>Customer cases</h2><span>@complaints.Count(x=>x.Resolution=="") open</span></div>@foreach(var complaint in complaints){<article class="queue-item"><a asp-controller="Orders" asp-action="Details" asp-route-id="@complaint.FoodOrderId"><strong>@complaint.Order.Reference · @complaint.Order.Vendor.Name</strong></a><p>@complaint.Text</p>@if(complaint.Resolution!=""){<p class="resolution">Resolved: @complaint.Resolution</p>}else{<form asp-action="Resolve" method="post"><input type="hidden" name="id" value="@complaint.Id"/><textarea name="resolution" required maxlength="1000" placeholder="Resolution and outcome"></textarea><button class="small-button">Resolve and notify</button></form>}</article>}@if(!complaints.Any()){<p class="admin-empty">No cases reported.</p>}</section></div></div></div>
