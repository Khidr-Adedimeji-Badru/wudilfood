@model List<FoodOrder>
@{ViewData["Title"]="Order oversight";var vendors=(List<Vendor>)ViewBag.Vendors;}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">ORDERS</span><h1>Order oversight</h1><p>Inspect platform orders without changing vendor fulfilment.</p></div><a class="small-button" asp-action="ExportOrders" asp-route-q="@ViewBag.Query" asp-route-vendorId="@ViewBag.VendorId" asp-route-state="@ViewBag.State" asp-route-payment="@ViewBag.Payment" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Export CSV</a></header>
<form method="get" class="admin-filterbar"><input name="q" value="@ViewBag.Query" placeholder="Reference or customer"/><select name="vendorId"><option value="">All vendors</option>@foreach(var vendor in vendors){<option value="@vendor.Id" selected="@(ViewBag.VendorId==vendor.Id)">@vendor.Name</option>}</select><select name="state" asp-items="Html.GetEnumSelectList<OrderState>()"><option value="">All statuses</option></select><select name="payment" asp-items="Html.GetEnumSelectList<PaymentState>()"><option value="">All payments</option></select><input name="from" type="date" value="@ViewBag.From"/><input name="to" type="date" value="@ViewBag.To"/><button class="small-button">Filter</button></form>
<section class="admin-panel table-scroll"><div class="admin-table-head"><span>Order</span><span>Vendor / customer</span><span>Fulfilment</span><span>Payment</span><span>Total</span></div>@foreach(var order in Model){<a class="admin-table-row" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><span><strong>@order.Reference</strong><small>@order.CreatedUtc.ToLocalTime().ToString("dd MMM, HH:mm")</small></span><span>@order.Vendor.Name<small>@order.Customer.FullName</small></span><span><i class="pill">@order.State</i><small>@order.Fulfillment</small></span><span>@order.PaymentState<small>@order.PaymentMethod</small></span><strong>NGN @order.Total.ToString("N0")</strong></a>}@if(!Model.Any()){<p class="admin-empty">No orders match these filters.</p>}</section></div></div>
