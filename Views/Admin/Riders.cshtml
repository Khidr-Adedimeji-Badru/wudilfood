@model List<Rider>
@{ViewData["Title"]="Rider directory";}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">DELIVERY TEAM</span><h1>Rider directory</h1><p>Maintain the contacts vendors can assign to delivery orders.</p></div><span class="queue-count">@Model.Count(x=>x.IsActive) active</span></header><div class="settings-grid"><form asp-action="SaveRider" method="post" class="admin-panel settings-form"><div class="panel-heading"><h2>Add rider</h2></div><label>Full name<input name="name" required maxlength="100"/></label><label>Phone number<input name="phoneNumber" type="tel" required maxlength="30" placeholder="e.g. 0803 000 0000"/></label><button class="small-button">Add to directory</button></form><section class="admin-panel"><div class="panel-heading"><h2>Delivery contacts</h2><span>@Model.Count</span></div>@foreach(var rider in Model){<details class="admin-record"><summary><span><strong>@rider.Name</strong><small>@rider.PhoneNumber</small></span><span class="account-state @(rider.IsActive?"active":"blocked")">@(rider.IsActive?"Active":"Inactive")</span></summary><div class="record-body"><form asp-action="SaveRider" method="post" class="decision-form"><input type="hidden" name="id" value="@rider.Id"/><label>Name<input name="name" value="@rider.Name" required maxlength="100"/></label><label>Phone<input name="phoneNumber" value="@rider.PhoneNumber" required maxlength="30"/></label><button class="small-button">Save details</button></form><form asp-action="RiderStatus" method="post"><input type="hidden" name="id" value="@rider.Id"/><button class="text-button">@(rider.IsActive?"Deactivate rider":"Activate rider")</button></form></div></details>}@if(!Model.Any()){<p class="admin-empty">No riders have been added.</p>}</section></div></div></div>
