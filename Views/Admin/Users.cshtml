@model IList<AppUser>
@{ViewData["Title"]="User management";var vendors=(IList<AppUser>)ViewBag.Vendors;}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">USERS</span><h1>Account access</h1><p>Review customer and vendor sign-in access.</p></div></header><div class="user-summary"><span><strong>@Model.Count</strong> customers</span><span><strong>@vendors.Count</strong> vendor users</span></div><section class="admin-panel"><div class="panel-heading"><h2>Customer accounts</h2></div>@foreach(var user in Model){var active=user.LockoutEnd==null||user.LockoutEnd<=DateTimeOffset.UtcNow;<details class="admin-record"><summary><span><strong>@user.FullName</strong><small>@user.Email · @user.PhoneNumber</small></span><span class="account-state @(active?"active":"blocked")">@(active?"Active":"Suspended")</span></summary><form asp-action="AccountStatus" method="post" class="record-body decision-form"><input type="hidden" name="id" value="@user.Id"/><input type="hidden" name="active" value="@(!active)"/><label>Reason<input name="reason" required maxlength="300"/></label><button class="small-button">@(active?"Suspend account":"Reactivate account")</button></form></details>}@if(!Model.Any()){<p class="admin-empty">No registered customers.</p>}</section></div></div>
