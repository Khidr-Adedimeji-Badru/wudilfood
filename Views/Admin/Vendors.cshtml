@model List<Vendor>
@{ViewData["Title"]="Vendor governance";}
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-workspace"><header class="workspace-head"><div><span class="eyebrow">VENDORS</span><h1>Vendor governance</h1><p>Review applications and control marketplace access.</p></div><span class="queue-count">@ViewBag.Pending pending</span></header><section class="admin-panel">@foreach(var vendor in Model){<details class="admin-record"><summary><span><strong>@vendor.Name</strong><small>@vendor.User.FullName · @vendor.Location · @vendor.Items.Count items</small></span><span class="pill">@vendor.Status</span></summary><div class="record-body"><p>@(string.IsNullOrWhiteSpace(vendor.Description)?"No business description supplied.":vendor.Description)</p><form asp-action="VendorStatus" method="post" class="decision-form"><input type="hidden" name="id" value="@vendor.Id"/><label>Decision reason<input name="reason" required maxlength="300" placeholder="Required for the audit trail"/></label><div class="actions"><button class="small-button" name="status" value="@ApprovalStatus.Approved">Approve</button><button class="text-button danger-text" name="status" value="@ApprovalStatus.Rejected">Reject</button><button class="text-button" name="status" value="@ApprovalStatus.Suspended">Suspend</button></div></form></div></details>}@if(!Model.Any()){<p class="admin-empty">No vendor accounts.</p>}</section></div></div>
