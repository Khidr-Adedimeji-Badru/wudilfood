@model List<MenuItem>
@{ViewData["Title"]="Your cart";var cart=(List<CartEntry>)ViewBag.Cart;}
<div class="page-head"><span class="eyebrow">YOUR ORDER</span><h1>Your cart</h1><p>Review quantities before checkout.</p></div>@if(Model.Count==0){<div class="empty"><strong>Your cart is empty</strong><p>Explore local kitchens and add something good.</p><a class="button" asp-controller="Marketplace">Browse food</a></div>}else{<div class="cart-layout"><div class="panel cart-items">@foreach(var i in Model){var qty=cart.First(x=>x.ItemId==i.Id).Quantity;<div class="cart-row"><div><span class="tag">@i.Vendor.Name</span><h3>@i.Name</h3><p class="muted">NGN @i.Price.ToString("N0") each</p></div><div class="cart-controls"><form asp-action="Update" method="post" class="quantity-form"><input type="hidden" name="id" value="@i.Id"/><label><span class="sr-only">Quantity for @i.Name</span><input name="quantity" type="number" value="@qty" min="0" max="@i.Stock"/></label><button class="small-button">Update</button></form><strong>NGN @((i.Price*qty).ToString("N0"))</strong><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@i.Id"/><button class="text-button">Remove</button></form></div></div>}</div><aside class="panel order-summary"><span class="eyebrow">SUMMARY</span><div class="row total"><strong>Items total</strong><strong>NGN @(Model.Sum(i=>i.Price*cart.First(x=>x.ItemId==i.Id).Quantity).ToString("N0"))</strong></div><p class="muted">Your delivery fee is calculated at checkout. One vendor per order keeps fulfilment reliable.</p><a class="button full" asp-controller="Orders" asp-action="Checkout">Continue to checkout</a><a class="back-link" asp-controller="Marketplace">Continue shopping</a></aside></div>}

