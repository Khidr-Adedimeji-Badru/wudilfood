@model List<MenuItem>
@{ViewData["Title"]="Favourite food";}
<div class="page-head"><span class="eyebrow">SAVED</span><h1>Your favourites</h1><p>Keep the meals you want to find again.</p></div><div class="grid">@foreach(var item in Model){<article class="food-card"><a class="food-photo" asp-action="Vendor" asp-route-id="@item.VendorId">@if(item.PrimaryImage!=null){<img src="@item.PrimaryImage" alt="@item.Name"/>}else{<span class="photo-placeholder">@item.Name.Substring(0,1)</span>}</a><div class="card-body"><h3>@item.Name</h3><p>@item.Vendor.Name</p><div class="card-foot"><strong><small>NGN</small> @item.Price.ToString("N0")</strong><div class="actions"><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="small-button">Add</button></form><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="returnUrl" value="/Marketplace/Favorites"/><button class="text-button">Remove</button></form></div></div></div></article>}@if(Model.Count==0){<div class="empty"><strong>No favourites yet</strong><p>Save food from the marketplace to find it here.</p><a class="button" asp-action="Index">Explore food</a></div>}</div>

