@model List<MenuItem>
@{ViewData["Title"]="Order food";var cats=(List<Category>)ViewBag.Categories;var favoriteIds=(List<int>)ViewBag.FavoriteIds;var recent=(List<MenuItem>)ViewBag.RecentItems;var selectedCategory=Context.Request.Query["category"].ToString();}
<section class="order-home"><div><span class="eyebrow">WUDIL + ADUSTECH FOOD DELIVERY</span><h1>What would you like to eat?</h1><p>Order from approved local kitchens for delivery or pickup.</p></div><div class="service-points"><span><strong>@Model.Count</strong> available items</span><span><strong>3</strong> fulfilment options</span></div></section>
<section class="marketplace"><form method="get" class="order-search"><input name="q" value="@ViewBag.Query" placeholder="Search meals, snacks or vendors"/><input name="location" value="@Context.Request.Query["location"]" placeholder="Delivery area"/><button class="button">Find food</button></form><nav class="category-strip"><a class="category-chip @(selectedCategory==""?"active":"")" asp-action="Index">All food</a>@foreach(var category in cats){<a class="category-chip @(selectedCategory==category.Id.ToString()?"active":"")" asp-action="Index" asp-route-category="@category.Id">@category.Name</a>}</nav>
@if(recent.Count>0){<div class="section-title"><div><span class="eyebrow">ORDER AGAIN</span><h2>Recently ordered</h2></div></div><div class="recent-strip">@foreach(var item in recent){<a asp-action="Vendor" asp-route-id="@item.VendorId"><span>@item.Name</span><small>@item.Vendor.Name · NGN @item.Price.ToString("N0")</small></a>}</div>}
<div class="section-title"><div><span class="eyebrow">MARKETPLACE</span><h2>Available food</h2></div><span class="result-count">@Model.Count items</span></div><div class="grid">@foreach(var item in Model){<article class="food-card"><a class="food-photo" asp-action="Vendor" asp-route-id="@item.VendorId">@if(item.PrimaryImage!=null){<img src="@item.PrimaryImage" alt="@item.Name" loading="lazy"/>}else{<span class="photo-placeholder">@item.Name.Substring(0,1)</span>}<span class="photo-status">@item.Mode</span></a><div class="card-body"><div class="card-meta"><span class="tag">@item.Category.Name</span>@if(User.IsInRole(Roles.Customer)){<form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><button class="favorite-button @(favoriteIds.Contains(item.Id)?"saved":"")" title="Toggle favourite">@(favoriteIds.Contains(item.Id)?"Saved":"Save")</button></form>}</div><h3>@item.Name</h3><p>@item.Description</p><a class="vendor-name" asp-action="Vendor" asp-route-id="@item.VendorId"><span class="vendor-title">@item.Vendor.Name</span><span>@item.Vendor.Location</span></a><div class="item-facts"><span>@item.PreparationMinutes min</span><span>@item.Stock available</span></div><div class="card-foot"><strong><small>NGN</small> @item.Price.ToString("N0")</strong><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="small-button">Add</button></form></div></div></article>}</div>@if(Model.Count==0){<div class="empty"><strong>No food found</strong><p>Try another search.</p></div>}</section>
<style>.recent-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:30px}.recent-strip a{display:grid;padding:14px;background:#fff;border:1px solid #dfe5dd;border-radius:6px;font-weight:800}.recent-strip small{margin-top:3px;color:#697870;font-weight:500}.favorite-button{border:1px solid #dfe5dd;background:#fff;color:#174c3c;padding:5px 8px;border-radius:5px;font-size:.72rem;font-weight:800}.favorite-button.saved{background:#e8f0e8;border-color:#174c3c}@@media(max-width:700px){.recent-strip{grid-template-columns:repeat(2,1fr)}}</style>

