@model CheckoutForm
@{ViewData["Title"]="Checkout";var settings=(PlatformSetting)ViewBag.Settings;var items=(List<MenuItem>)(ViewBag.CartItems??new List<MenuItem>());var cart=(List<CartEntry>)(ViewBag.Cart??new List<CartEntry>());var subtotal=items.Sum(x=>x.Price*(cart.FirstOrDefault(c=>c.ItemId==x.Id)?.Quantity??0));}
<div class="page-head"><span class="eyebrow">CHECKOUT</span><h1>Complete your order</h1><p>Review every detail before placing the order.</p></div>
<div class="checkout-layout"><form asp-action="Checkout" method="post" class="panel stack"><div asp-validation-summary="All" class="error"></div>@if(User.Identity?.IsAuthenticated!=true){<div class="form-section"><h3>Your contact details</h3><p class="hint">Used for fulfilment and secure guest tracking.</p><div class="form-grid"><label>Full name<input asp-for="GuestName" required autocomplete="name"/></label><label>Phone number<input asp-for="GuestPhone" required autocomplete="tel"/></label><label class="wide">Email address<input asp-for="GuestEmail" type="email" required autocomplete="email"/></label></div></div>}<div class="form-section"><h3>Fulfilment</h3><label>Food ready for<input asp-for="LocalSlot" type="datetime-local"/></label><label>Method<select asp-for="Fulfillment" asp-items="Html.GetEnumSelectList<Fulfillment>()"></select></label><p class="hint">Delivery costs NGN @settings.DeliveryFee.ToString("N0") within @settings.Coverage. Pickup and vendor collection are free.</p><label>Delivery address<input asp-for="DeliveryAddress" placeholder="Required for delivery"/></label></div><div class="form-section"><h3>Payment and notes</h3><label>Payment method<select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select></label><label>Note to kitchen<textarea asp-for="Note" rows="3"></textarea></label></div><button class="button full">Place order</button></form>
<aside class="panel checkout-summary"><span class="eyebrow">ORDER SUMMARY</span>@foreach(var item in items){var qty=cart.First(x=>x.ItemId==item.Id).Quantity;<div class="row"><div><strong>@item.Name</strong><p class="muted">@qty × NGN @item.Price.ToString("N0")</p></div><strong>NGN @((qty*item.Price).ToString("N0"))</strong></div>}<div class="row total"><strong>Subtotal</strong><strong>NGN @subtotal.ToString("N0")</strong></div><p class="muted">Delivery charges apply only when Delivery is selected. The final order reference and pickup code are issued after submission.</p></aside></div>
<style>.checkout-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:22px;align-items:start}.checkout-summary{position:sticky;top:95px}@@media(max-width:800px){.checkout-layout{grid-template-columns:1fr}.checkout-summary{position:static}}</style>

