@model FoodOrder
@{ViewData["Title"]=Model.Reference;var customerCanManage=(bool?)ViewBag.CustomerCanManage==true;var history=(List<OrderStatusHistory>)(ViewBag.History??new List<OrderStatusHistory>());var riders=(List<Rider>)(ViewBag.Riders??new List<Rider>());var vendorNext=OrderWorkflow.Next(Model.State,Model.Fulfillment);var timeline=OrderWorkflow.Timeline(Model.Fulfillment);var currentIndex=Array.IndexOf(timeline.ToArray(),Model.State);var pickupCode=Model.Reference.Length>=6?Model.Reference[^6..]:"";var orderPlaced=TempData["OrderPlaced"] as string=="true";}
<div class="page-head"><span class="eyebrow">ORDER @Model.Reference</span><h1>@Model.State</h1><p>@Model.Vendor.Name · @Model.SlotUtc.ToLocalTime().ToString("ddd dd MMM, h:mm tt")</p></div>
@if(orderPlaced){<section class="order-confirmation"><div><span class="eyebrow">ORDER CONFIRMED</span><h2>Keep your tracking reference</h2><p>Use this reference and the phone number from checkout to track your order later.</p></div><div class="tracking-reference"><small>TRACKING REFERENCE</small><strong>@Model.Reference</strong></div></section>}
@if(TempData["Message"]!=null){<div class="status-banner success">@TempData["Message"]</div>}
<div class="order-timeline">@foreach(var step in timeline){var index=Array.IndexOf(timeline.ToArray(),step);var done=Model.State==OrderState.Completed||index<=currentIndex;<div class="timeline-step @(done?"done":"")"><span></span><small>@step</small></div>}</div>
@if(Model.Fulfillment==Fulfillment.Delivery){<section class="delivery-contact"><div class="section-title"><div><span class="eyebrow">DELIVERY CONTACT</span><h2>Your rider</h2></div></div>@if(Model.Rider!=null){<div class="panel rider-card"><div><small>ASSIGNED RIDER</small><strong>@Model.Rider.Name</strong><span>@Model.Rider.PhoneNumber</span></div><a class="button" href="tel:@Model.Rider.PhoneNumber">Call rider</a></div>}else{<div class="panel rider-pending"><strong>Rider assignment pending</strong><p>The vendor will add the delivery contact before your order leaves the kitchen.</p></div>}@if(User.IsInRole(Roles.Vendor)&&Model.State is not OrderState.Cancelled and not OrderState.Completed){<form asp-controller="Vendor" asp-action="AssignRider" method="post" class="panel rider-assignment"><input type="hidden" name="id" value="@Model.Id"/><label>Assign delivery rider<select name="riderId" required><option value="">Choose an active rider</option>@foreach(var rider in riders){<option value="@rider.Id" selected="@(Model.RiderId==rider.Id)">@rider.Name · @rider.PhoneNumber</option>}</select></label><button class="small-button">Save rider</button>@if(!riders.Any()){<p class="muted">No active riders are available. Ask the administrator to add one.</p>}</form>}</section><style>.rider-card{display:flex;justify-content:space-between;align-items:center;gap:20px;border-left:4px solid #24744e}.rider-card>div{display:grid}.rider-card small{color:#697870;font-weight:800}.rider-card strong{font:700 1.45rem Outfit}.rider-card span{color:#697870}.rider-pending{border-left:4px solid #c28a1b}.rider-pending p{margin-bottom:0;color:#697870}.rider-assignment{display:flex;align-items:end;gap:12px;margin-top:12px}.rider-assignment label{display:grid;gap:5px;flex:1;font-size:.76rem;font-weight:800}@@media(max-width:700px){.rider-card,.rider-assignment{align-items:stretch;flex-direction:column}}</style>}
<div class="two-col"><div class="panel"><h2>Order details</h2>@foreach(var line in Model.Lines){<div class="row"><span>@line.Quantity × @line.ItemName</span><strong>NGN @((line.UnitPrice*line.Quantity).ToString("N0"))</strong></div>}<div class="row"><span>Delivery</span><strong>NGN @Model.DeliveryFee.ToString("N0")</strong></div><div class="row total"><strong>Total</strong><strong>NGN @Model.Total.ToString("N0")</strong></div><p>Fulfilment: @Model.Fulfillment<br/>Payment: @Model.PaymentMethod · @Model.PaymentState</p>@if(Model.Fulfillment!=Fulfillment.Delivery&&customerCanManage){<div class="pickup-code"><small>HANDOVER CODE</small><strong>@pickupCode</strong><p>Show this code when collecting your order.</p></div>}@if(Model.DeliveryAddress!=null){<p>Address: @Model.DeliveryAddress</p>}@if(Model.Note!=null){<p>Note: @Model.Note</p>}</div>
<div class="panel stack"><h2>Actions</h2>@if(User.IsInRole(Roles.Vendor)&&vendorNext.HasValue){<form asp-controller="Vendor" asp-action="State" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="state" value="@vendorNext.Value"/><button class="button">@OrderWorkflow.ActionLabel(vendorNext.Value)</button></form>@if(OrderWorkflow.CanCancel(Model.State)){<form asp-controller="Vendor" asp-action="State" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="state" value="@OrderState.Cancelled"/><button class="text-button danger-text">Cancel order</button></form>}}@if(customerCanManage){if(Model.State==OrderState.Delivered||(Model.State==OrderState.Ready&&Model.Fulfillment!=Fulfillment.Delivery)){<form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="button">Confirm receipt</button></form>}if(OrderWorkflow.CanCancel(Model.State)){<details><summary>Request cancellation</summary><form asp-action="RequestCancellation" method="post" class="stack compact-form"><input type="hidden" name="id" value="@Model.Id"/><label>Reason<select name="reason" required><option value="">Choose a reason</option><option>Ordered by mistake</option><option>Need to change order</option><option>Delivery timing</option><option>Payment issue</option><option>Other</option></select></label><label>Details<textarea name="details" maxlength="600"></textarea></label><button class="small-button">Send request</button></form></details>}if(Model.State==OrderState.Completed){<form asp-action="Reorder" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="button">Reorder available items</button></form>}if(Model.State==OrderState.Completed&&Model.Review==null){<form asp-action="Review" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id"/><label>Rating<select name="rating"><option value="5">5 · Excellent</option><option value="4">4 · Great</option><option value="3">3 · Good</option></select></label><label>Review<textarea name="comment" required maxlength="1000"></textarea></label><button class="small-button">Submit review</button></form>}<form asp-action="Complain" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id"/><label>Need help?<textarea name="text" required maxlength="1500"></textarea></label><button class="text-button">Send complaint</button></form>}@if(User.IsInRole(Roles.Admin)){<form asp-controller="Admin" asp-action="Payment" method="post"><input type="hidden" name="id" value="@Model.Id"/><select name="status" asp-items="Html.GetEnumSelectList<PaymentState>()"></select><button class="small-button">Update payment</button></form>}</div></div>
@if(history.Count>0){<section><h2>Status history</h2><div class="panel">@foreach(var entry in history.OrderByDescending(x=>x.ChangedUtc)){<div class="row"><div><strong>@entry.ToState</strong><p class="muted">@(entry.FromState.HasValue?$"Changed from {entry.FromState}":"Order placed")</p></div><time class="muted">@entry.ChangedUtc.ToLocalTime().ToString("dd MMM, h:mm tt")</time></div>}</div></section>}
<style>.order-confirmation{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px;margin-bottom:28px;background:#e8f0e8;border-left:4px solid #24744e}.order-confirmation h2,.order-confirmation p{margin:3px 0}.order-confirmation p{color:#697870}.tracking-reference{min-width:250px;padding:15px 18px;background:#fff;border:1px solid #cfdacf}.tracking-reference small{display:block;font-weight:800;color:#697870}.tracking-reference strong{display:block;font:800 1.45rem Outfit}.order-timeline{display:grid;grid-template-columns:repeat(@timeline.Count,1fr);margin-bottom:28px}.timeline-step{position:relative;display:grid;justify-items:center;gap:7px}.timeline-step:before{content:'';position:absolute;top:7px;width:100%;height:3px;background:#dfe5dd}.timeline-step span{z-index:1;width:17px;height:17px;border:3px solid #dfe5dd;border-radius:50%;background:#f7f7f2}.timeline-step.done:before{background:#24744e}.timeline-step.done span{border-color:#24744e;background:#d7ed83}.pickup-code{margin:18px 0;padding:16px;background:#eef3ed;border-left:3px solid #174c3c}.pickup-code strong{display:block;font:800 2rem Outfit;letter-spacing:.12em}.pickup-code p{margin:2px 0;color:#697870}.compact-form{margin-top:12px}@@media(max-width:700px){.order-confirmation{align-items:stretch;flex-direction:column}.tracking-reference{min-width:0}}</style>

