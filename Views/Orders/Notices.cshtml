@model List<Notice>
@{ViewData["Title"]="Updates";}
<div class="page-head"><span class="eyebrow">INBOX</span><h1>Your updates</h1></div><div class="panel">@foreach(var n in Model){<div class="row"><span>@n.Text</span><small class="muted">@n.CreatedUtc.ToLocalTime().ToString("dd MMM, h:mm tt")</small></div>}@if(Model.Count==0){<p>You're all caught up.</p>}</div>
