<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#173f35"/><title>@ViewData["Title"] | Wudil Food</title><link rel="stylesheet" href="~/css/site.css"/>@if(User.IsInRole(Roles.Admin)){<link rel="stylesheet" href="~/css/admin.css"/>}</head>
<body><header class="top"><nav class="wrap nav" aria-label="Main navigation"><a class="brand" asp-controller="@(User.IsInRole(Roles.Admin)?"Admin":"Marketplace")" asp-action="Index"><span class="mark">WF</span><span>Wudil Food<small>@(User.IsInRole(Roles.Admin)?"Administration":"ADUSTECH marketplace")</small></span></a><div class="links">@if(User.IsInRole(Roles.Admin)){<a asp-controller="Admin" asp-action="Index">Overview</a><a asp-controller="Admin" asp-action="Orders">Orders</a><a asp-controller="Admin" asp-action="Vendors">Vendors</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="navbutton">Sign out</button></form>}else{<a asp-controller="Marketplace" asp-action="Index">Explore</a>@if(!User.IsInRole(Roles.Vendor)){<a asp-controller="Cart" asp-action="Index">Cart</a>}@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Orders" asp-action="Index">Orders</a>@if(User.IsInRole(Roles.Customer)){<a asp-controller="Marketplace" asp-action="Favorites">Favourites</a>}<a asp-controller="Orders" asp-action="Notices">Updates</a>@if(User.IsInRole(Roles.Vendor)){<a asp-controller="Vendor" asp-action="Index">My kitchen</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="navbutton">Sign out</button></form>}else{<a asp-controller="Orders" asp-action="Track">Track order</a><a asp-controller="Account" asp-action="Login">Sign in</a><a class="navcta" asp-controller="Account" asp-action="Register">Create account</a>}}</div></nav></header><main class="wrap">@RenderBody()</main><footer><div class="wrap footer"><div><strong>Wudil Food</strong><p>@(User.IsInRole(Roles.Admin)?"Marketplace administration and oversight.":"Local kitchens, campus favourites, one simple order.")</p></div><div>Serving Wudil and the ADUSTECH community</div></div></footer></body></html>
