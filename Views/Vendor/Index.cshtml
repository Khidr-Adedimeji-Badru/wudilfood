@model Vendor
@{ViewData["Title"]="My kitchen";var approved=Model.Status==ApprovalStatus.Approved;var orders=(List<FoodOrder>)(ViewBag.Orders??new List<FoodOrder>());var active=orders.Where(x=>x.State!=OrderState.Completed&&x.State!=OrderState.Cancelled).ToList();var pending=active.Count(x=>x.State==OrderState.Pending);var revenue=(decimal)(ViewBag.Revenue??0m);var completed=(int)(ViewBag.CompletedCount??0);var topItems=(List<WudilFood.Controllers.VendorProductStat>)(ViewBag.TopItems??new List<WudilFood.Controllers.VendorProductStat>());var closures=(List<VendorClosure>)(ViewBag.Closures??new List<VendorClosure>());}
<div class="page-head"><span class="eyebrow">VENDOR STUDIO</span><h1>My kitchen</h1><p>Manage orders, menu and business details.</p></div>
@if(Model.Status==ApprovalStatus.Pending){<div class="status-banner warning"><div><strong>Your registration is awaiting administrator review</strong><p>Menu and order management become available after approval.</p></div><span class="pill">Pending</span></div>}else if(Model.Status==ApprovalStatus.Rejected){<div class="status-banner danger"><div><strong>Your vendor registration was not approved</strong><p>Review your business details and contact the administrator.</p></div><span class="pill">Rejected</span></div>}else if(Model.Status==ApprovalStatus.Suspended){<div class="status-banner danger"><div><strong>Your vendor account is suspended</strong><p>Your menu is hidden from customers.</p></div><span class="pill">Suspended</span></div>}else{<div class="status-banner success"><div><strong>Your kitchen is approved</strong><p>Your available menu and active orders are live.</p></div><a class="small-button" asp-controller="Marketplace" asp-action="Vendor" asp-route-id="@Model.Id">View storefront</a></div>}
@if(approved){
@if(pending>0){<div class="status-banner warning"><div><strong>@pending new order@(pending==1?"":"s") need attention</strong><p>Review incoming orders and start preparation.</p></div><a class="small-button" asp-action="Index" asp-route-state="@OrderState.Pending">Review now</a></div>}
<section><div class="section-title"><div><span class="eyebrow">PERFORMANCE</span><h2>Kitchen overview</h2></div></div><div class="stats vendor-metrics"><div><small>COMPLETED</small><strong>@completed</strong></div><div><small>ITEM REVENUE</small><strong>NGN @revenue.ToString("N0")</strong></div><div><small>AVERAGE ORDER</small><strong>NGN @(completed==0?"0":(revenue/completed).ToString("N0"))</strong></div><div><small>BEST SELLER</small><strong class="metric-name">@(topItems.FirstOrDefault()?.Name??"No sales yet")</strong></div></div>@if(topItems.Count>0){<div class="panel top-products"><h3>Top products</h3>@foreach(var product in topItems){<div class="row"><span>@product.Name</span><span><strong>@product.Quantity sold</strong> · NGN @product.Revenue.ToString("N0")</span></div>}</div>}</section>
<section class="vendor-orders"><div class="section-title"><div><span class="eyebrow">ORDER MANAGEMENT</span><h2>Orders</h2></div><a asp-controller="Orders" asp-action="Index">View order history</a></div>
<nav class="category-strip"><a class="category-chip" asp-action="Index">All</a><a class="category-chip" asp-action="Index" asp-route-state="@OrderState.Pending">Pending</a><a class="category-chip" asp-action="Index" asp-route-state="@OrderState.Processing">Processing</a><a class="category-chip" asp-action="Index" asp-route-state="@OrderState.Ready">Ready</a><a class="category-chip" asp-action="Index" asp-route-state="@OrderState.Shipped">Shipped</a><a class="category-chip" asp-action="Index" asp-route-state="@OrderState.Completed">Completed</a></nav>
<form method="get" class="filters compact"><label><span>Search</span><input name="q" value="@ViewBag.Query" placeholder="Reference or customer"/></label><label><span>Fulfilment</span><select name="fulfillment" asp-items="Html.GetEnumSelectList<Fulfillment>()"><option value="">All types</option></select></label><label><span>Scheduled date</span><input name="date" type="date" value="@ViewBag.Date"/></label><button class="small-button">Filter</button><a asp-action="Index" class="clear-filter">Clear</a></form>
<div class="order-stats"><div><strong>@active.Count(x=>x.State==OrderState.Pending)</strong><span>Pending</span></div><div><strong>@active.Count(x=>x.State==OrderState.Processing||x.State==OrderState.Accepted)</strong><span>Processing</span></div><div><strong>@active.Count(x=>x.State==OrderState.Ready)</strong><span>Ready</span></div><div><strong>@active.Count(x=>x.State==OrderState.Shipped||x.State==OrderState.Delivered)</strong><span>In fulfilment</span></div></div>
<div class="order-board">@foreach(var order in active){var next=order.State switch{OrderState.Pending=>OrderState.Processing,OrderState.Accepted=>OrderState.Processing,OrderState.Processing=>OrderState.Ready,OrderState.Ready when order.Fulfillment==Fulfillment.Delivery=>OrderState.Shipped,OrderState.Ready=>OrderState.Completed,OrderState.Shipped=>OrderState.Delivered,OrderState.Delivered=>OrderState.Completed,_=>(OrderState?)null};var action=next switch{OrderState.Processing=>"Start processing",OrderState.Ready=>"Mark ready",OrderState.Shipped=>"Mark shipped",OrderState.Delivered=>"Mark delivered",OrderState.Completed=>"Complete order",_=>"Update"};<article class="order-card"><div class="order-card-head"><div><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><strong>@order.Reference</strong></a><p>@order.Customer.FullName · @order.SlotUtc.ToLocalTime().ToString("dd MMM, h:mm tt")</p></div><span class="pill">@order.State</span></div><div class="order-lines">@foreach(var line in order.Lines){<span>@line.Quantity × @line.ItemName</span>}</div><div class="order-meta"><span>@order.Fulfillment</span><strong>NGN @order.Total.ToString("N0")</strong></div><div class="actions">@if(next.HasValue){<form asp-action="State" method="post"><input type="hidden" name="id" value="@order.Id"/><input type="hidden" name="state" value="@next.Value"/><input type="hidden" name="returnTo" value="vendor"/><button class="small-button">@action</button></form>}@if(order.State==OrderState.Pending||order.State==OrderState.Processing||order.State==OrderState.Accepted){<form asp-action="State" method="post"><input type="hidden" name="id" value="@order.Id"/><input type="hidden" name="state" value="@OrderState.Cancelled"/><input type="hidden" name="returnTo" value="vendor"/><button class="text-button danger-text">Cancel</button></form>}</div></article>}@if(active.Count==0){<div class="empty"><strong>No active orders</strong><p>New customer orders will appear here.</p></div>}</div></section>}
@if(approved){<section class="two-col operations"><div class="panel"><h2>Temporary closures</h2><p class="muted">Block checkout during holidays or maintenance.</p><form asp-action="Closure" method="post" class="stack"><label>From<input name="startsLocal" type="datetime-local" required/></label><label>Until<input name="endsLocal" type="datetime-local" required/></label><label>Reason<input name="reason" maxlength="200" placeholder="Public reason"/></label><button class="small-button">Schedule closure</button></form></div><div class="panel"><h2>Upcoming closures</h2>@foreach(var closure in closures){<div class="row"><div><strong>@closure.StartsUtc.ToLocalTime().ToString("dd MMM, h:mm tt")</strong><p class="muted">Until @closure.EndsUtc.ToLocalTime().ToString("dd MMM, h:mm tt") · @closure.Reason</p></div><form asp-action="DeleteClosure" method="post"><input type="hidden" name="id" value="@closure.Id"/><button class="text-button danger-text">Remove</button></form></div>}@if(closures.Count==0){<p class="muted">No closure periods scheduled.</p>}</div></section>}
<div class="two-col"><form asp-action="Profile" method="post" class="panel stack"><h2>Kitchen profile</h2><label>Name<input name="name" value="@Model.Name" required/></label><label>Description<textarea name="description">@Model.Description</textarea></label><label>Location<input name="location" value="@Model.Location" required/></label><label>Operating hours<input name="operatingHours" value="@Model.OperatingHours"/></label><button class="small-button">Save profile</button></form><div class="panel"><h2>Menu management</h2>@if(approved){<p>Add meals, snacks or drinks for customers to order.</p><a class="button" asp-action="Item">Add menu item</a>}else{<p class="muted">Menu creation is locked until administrator approval.</p>}</div></div>
<div class="section-title"><h2>Your menu</h2><span class="muted">@Model.Items.Count items</span></div><div class="panel menu-list">@if(approved&&Model.Items.Any()){<form asp-action="BulkStock" method="post"><div class="bulk-head"><span>Update stock counts together</span><button class="small-button">Save stock</button></div>@foreach(var item in Model.Items){var live=item.IsVisible&&item.Stock>0&&item.Mode!=AvailabilityMode.Unavailable;var reason=!item.IsVisible?"Hidden":item.Stock<=0?"Out of stock":item.Mode==AvailabilityMode.Unavailable?"Unavailable":"Live in marketplace";<div class="row menu-operation"><div class="menu-list-item">@if(item.PrimaryImage!=null){<img src="@item.PrimaryImage" alt=""/>}<div><strong>@item.Name</strong><p class="muted">NGN @item.Price.ToString("N0") · @item.Schedules.Count schedule@(item.Schedules.Count==1?"":"s")</p><span class="publish-state @(live?"live":"offline")">@reason</span></div></div><input type="hidden" name="itemIds" value="@item.Id"/><label class="stock-field"><span>Stock</span><input type="number" name="stocks" value="@item.Stock" min="0" max="100000"/></label><div class="actions"><a class="small-button" asp-action="Item" asp-route-id="@item.Id">Edit</a><button class="text-button" type="submit" formaction="@Url.Action("SoldOut",new{id=item.Id})">Sold out</button><button class="text-button" type="submit" formaction="@Url.Action("Duplicate",new{id=item.Id})">Duplicate</button><button class="text-button" type="submit" formaction="@Url.Action("Hide",new{id=item.Id})">@(item.IsVisible?"Hide":"Show")</button></div></div>}</form>}else{@foreach(var item in Model.Items){<div class="row"><strong>@item.Name</strong><span class="muted">@item.Stock in stock</span></div>}}@if(!Model.Items.Any()){<div class="empty">No menu items yet.</div>}</div>
<style>.status-banner{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:18px 20px;margin-bottom:24px;border-left:4px solid;border-radius:6px}.status-banner p{margin:3px 0}.status-banner.warning{background:#fff7df;border-color:#c28a1b}.status-banner.danger{background:#fae9e7;border-color:#a43d35}.status-banner.success{background:#e7f3e9;border-color:#24744e}.order-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.order-stats div{padding:14px;background:#e8f0e8;border-radius:6px}.order-stats strong{display:block;font:700 1.7rem Outfit}.order-stats span{font-size:.76rem;color:#697870}.order-board{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.order-card{padding:18px;background:#fff;border:1px solid #dfe5dd;border-radius:8px}.order-card-head,.order-meta{display:flex;justify-content:space-between;gap:14px}.order-card-head p{margin:3px 0;color:#697870;font-size:.8rem}.order-lines{display:grid;gap:3px;padding:12px 0;margin:10px 0;border-block:1px solid #dfe5dd;font-size:.85rem}.order-meta{margin-bottom:13px;font-size:.84rem}.menu-list-item{display:flex;align-items:center;gap:14px}.menu-list-item img{width:68px;height:54px;object-fit:cover;border-radius:5px}.publish-state{font-size:.72rem;font-weight:800}.publish-state.live{color:#24744e}.publish-state.offline,.danger-text{color:#a43d35}.vendor-metrics strong{font-size:1.45rem}.vendor-metrics .metric-name{font-size:1.15rem}.top-products{margin-top:-22px}.bulk-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:14px;border-bottom:1px solid #dfe5dd}.menu-operation{display:grid;grid-template-columns:minmax(220px,1fr) 90px auto}.stock-field{font-size:.72rem;font-weight:800}.stock-field input{padding:8px}.operations label{display:grid;gap:5px;font-size:.76rem;font-weight:800}@@media(max-width:850px){.menu-operation{grid-template-columns:1fr}.menu-operation .actions{grid-column:1}.vendor-metrics{grid-template-columns:repeat(2,1fr)}}@@media(max-width:700px){.order-stats{grid-template-columns:repeat(2,1fr)}.order-board{grid-template-columns:1fr}.vendor-metrics{grid-template-columns:1fr}}</style>

