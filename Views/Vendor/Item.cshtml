@model ItemForm
@{ViewData["Title"]=Model.Id>0?"Edit item":"Add item";var cats=(List<Category>)ViewBag.Categories;var schedules=(List<FoodSchedule>)(ViewBag.Schedules??new List<FoodSchedule>());}
<div class="page-head"><span class="eyebrow">MENU EDITOR</span><h1>@ViewData["Title"]</h1><p>Keep pricing, stock, images and availability accurate.</p></div>
<form asp-action="Item" method="post" enctype="multipart/form-data" class="panel stack narrow">
 <div asp-validation-summary="All" class="error"></div><input asp-for="Id" type="hidden"/>
 <label>Item name<input asp-for="Name" required/></label><label>Description<textarea asp-for="Description"></textarea></label>
 <div class="form-grid"><label>Price (NGN)<input asp-for="Price" type="number" min="1" step="0.01"/></label><label>Quantity available<input asp-for="Stock" type="number" min="0"/></label><label>Preparation time (minutes)<input asp-for="PreparationMinutes" type="number" min="1"/></label><label>Category<select asp-for="CategoryId">@foreach(var c in cats){<option value="@c.Id">@c.Name</option>}</select></label></div>
 <div class="form-section"><h3>Food images</h3><p class="hint">Upload up to 3 JPG, PNG or WebP images. The first image is the marketplace cover.</p>
 @if(Model.ExistingImages.Count>0){<div id="existing-images" class="image-preview-grid existing-images">@foreach(var image in Model.ExistingImages){<div class="image-preview" data-image="@image"><img src="@image" alt="Current item image"/><input type="hidden" name="ImageOrder" value="@image"/><span><button type="button" class="image-move" data-direction="-1" title="Move image left">&#8592;</button><button type="button" class="image-move" data-direction="1" title="Move image right">&#8594;</button><label><input type="checkbox" name="RemoveImages" value="@image"/> Remove</label></span></div>}</div>}
 <label class="upload-control"><span>Choose images</span><input asp-for="Images" type="file" accept="image/jpeg,image/png,image/webp" multiple/></label><div id="image-previews" class="image-preview-grid" aria-live="polite"></div><p id="image-count" class="hint"></p></div>
 <label>Availability<select asp-for="Mode" asp-items="Html.GetEnumSelectList<AvailabilityMode>()"></select></label><label class="check"><input asp-for="IsVisible"/> Show in marketplace</label><button class="button">Save item</button>
</form>
@if(Model.Id>0){<section class="panel narrow schedule-editor"><div class="section-title"><div><span class="eyebrow">PRE-ORDER WINDOWS</span><h2>Weekly availability</h2></div><span class="result-count">@schedules.Count slots</span></div>
 <div class="schedule-list">@foreach(var slot in schedules){<div class="row"><div><strong>@slot.Day</strong><p class="muted">@slot.StartsAt.ToString("HH:mm") - @slot.EndsAt.ToString("HH:mm") · order by @slot.OrderDeadline.ToString("HH:mm") @(slot.Capacity.HasValue?$"· {slot.Capacity} portions":"")</p></div><form asp-action="DeleteSchedule" method="post"><input type="hidden" name="id" value="@slot.Id"/><button class="text-button danger-text">Remove</button></form></div>}@if(schedules.Count==0){<p class="muted">No recurring pre-order windows yet.</p>}</div>
 <form asp-action="Schedule" method="post" class="stack"><input type="hidden" name="itemId" value="@Model.Id"/><div class="form-grid"><label>Day<select name="day" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select></label><label>Capacity (optional)<input name="capacity" type="number" min="1"/></label><label>Available from<input name="startsAt" type="time" value="08:00" required/></label><label>Available until<input name="endsAt" type="time" value="20:00" required/></label><label>Same-day deadline<input name="orderDeadline" type="time" value="18:00" required/></label></div><button class="small-button">Add weekly slot</button></form>
</section>}
<script>(()=>{const input=document.getElementById('Images'),preview=document.getElementById('image-previews'),count=document.getElementById('image-count'),list=document.getElementById('existing-images');input.addEventListener('change',()=>{preview.replaceChildren();const files=[...input.files],kept=list?[...list.querySelectorAll('input[name="RemoveImages"]')].filter(x=>!x.checked).length:0;count.textContent=(kept+files.length)+' of 3 images selected';input.setCustomValidity(kept+files.length>3?'Each item can have no more than 3 images.':'');files.slice(0,3).forEach(file=>{const box=document.createElement('div');box.className='image-preview';const img=document.createElement('img');img.alt=file.name;img.src=URL.createObjectURL(file);const name=document.createElement('span');name.textContent=file.name;box.append(img,name);preview.append(box)})});list?.addEventListener('click',e=>{const button=e.target.closest('.image-move');if(!button)return;const card=button.closest('.image-preview'),sibling=Number(button.dataset.direction)<0?card.previousElementSibling:card.nextElementSibling;if(!sibling)return;Number(button.dataset.direction)<0?list.insertBefore(card,sibling):list.insertBefore(sibling,card)});})();</script>
<style>.schedule-editor{margin-top:20px}.image-preview>span{display:flex;align-items:center;gap:5px}.image-move{border:1px solid #ccd6cc;background:#fff;border-radius:4px;width:28px;height:28px}.schedule-list{margin-bottom:20px}</style>
